# ORCA mobile — environment template.
#
# Copy to `mobile/.env` and adjust. NEVER commit `.env`.
#   cp .env.example .env
#
# Note: values here are bundled into the app asset at build time, so this file
# must hold endpoints and flags only — never a secret key.

# FastAPI backend.
# 10.0.2.2 is the host machine as seen from the Android emulator.
# On a physical handset, use your machine's LAN IP, e.g. http://192.168.1.5:8000
API_BASE_URL=http://10.0.2.2:8000

# Base map raster tiles.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=© OpenStreetMap contributors

# Replay a scripted GPS track toward the IMBL instead of using the real
# receiver, so the boundary alarm can be filmed on land. Set false on a vessel.
DEMO_MODE=true
