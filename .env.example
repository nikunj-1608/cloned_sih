# ORCA — shared environment template.
#
# Copy to `.env` and fill in real values. NEVER commit `.env`.
#   cp .env.example .env

# --- Supabase / PostGIS -------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/orca

# --- Google Gemini ------------------------------------------------------
# Uses the `google-genai` SDK. Gemini 1.5 Flash is retired; target 2.5 Flash.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# --- AI4Bharat Bhashini (regional STT/TTS) ------------------------------
# Optional. The app falls back to on-device speech when these are unset.
BHASHINI_USER_ID=your-ulca-user-id
BHASHINI_API_KEY=your-ulca-api-key
BHASHINI_PIPELINE_ID=your-pipeline-id

# --- Open-Meteo ---------------------------------------------------------
# No key required. Listed so the endpoint is configurable.
OPEN_METEO_MARINE_URL=https://marine-api.open-meteo.com/v1/marine
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
